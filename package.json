{
  "name": "with-vite-react",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "eslint": "^8.57.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "turbo": "^2.10.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.9"
    }
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "bun run --filter @repo/database generate",
    "db:migrate": "bun run --filter @repo/database migrate",
    "db:push": "bun run --filter @repo/database push",
    "db:check": "bun run --filter @repo/database check"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@tavily/core": "^0.7.6",
    "groq-sdk": "^1.4.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
