{
  "name": "with-vite-react",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "turbo": "^2.10.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.9"
    }
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "lint": "eslint \"apps/web/src/**/*.{ts,tsx}\" \"packages/ui/**/*.{ts,tsx}\"",
    "lint:all": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,md,json,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,css,md,json,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "prepare": "husky",
    "db:generate": "bun run --filter @repo/database generate",
    "db:migrate": "bun run --filter @repo/database migrate",
    "db:push": "bun run --filter @repo/database push",
    "db:check": "bun run --filter @repo/database check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint",
      "prettier --write"
    ],
    "*.{css,md,json}": "prettier --write"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@tavily/core": "^0.7.6",
    "groq-sdk": "^1.4.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
